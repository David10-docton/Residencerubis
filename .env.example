# Copiez ce fichier en `.env` (à la racine du projet) puis renseignez
# vos vraies valeurs. Le fichier .env ne doit JAMAIS être commité (voir .gitignore).
#
# --- Base de données (local WAMP : valeurs par défaut) ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=residencerubis

# --- Admin (optionnel, sinon valeurs par défaut de admin/auth.php) ---
# ADMIN_USER=admin
# Générer un hash bcrypt : https://bcrypt-generator.com/ ou `php -r "echo password_hash('votre-mot-de-passe', PASSWORD_BCRYPT);"`
# ADMIN_PASS_HASH=$2y$10$...
