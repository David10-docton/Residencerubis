# =============================================================
# Résidence Rubis — Fichier de configuration
# =============================================================
# Copiez ce fichier en `.env` puis renseignez vos vraies valeurs.
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore).
#
# Génération rapide : php setup.php
# =============================================================

# --- Base de données (local WAMP : valeurs par défaut) ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=residencerubis

# --- Admin (OBLIGATOIRE) ---
# Identifiant de connexion au panneau d'administration.
ADMIN_USER=admin

# Mot de passe en clair (utilisé pour la première connexion).
# Recommandé : définir uniquement ADMIN_PASS_HASH ci-dessous.
ADMIN_PASS=changez-mot-de-passe

# Hash bcrypt du mot de passe (recommandé en production).
# Générer avec : php -r "echo password_hash('votre-mot-de-passe', PASSWORD_BCRYPT);"
# Ou via : php setup.php
# ADMIN_PASS_HASH=$2y$10$...
